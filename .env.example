# Copy this file to .env and fill in the values.
#   cp .env.example .env
# The server reads .env once at startup, so restart it after any change here.

# Common
# ======
PORT=3001
LOG_LEVEL=debug

# Node Configuration:
# ==================
# One of: dev | test | prod. Note "prod", not "production".
NODE_ENV=dev

# JWT Secret:
# ==========
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-32+-char-random-string"

# DB URL:
# =====
# Postgres connection string. Local Docker or a cloud database both work.
# Local example:
#   postgresql://postgres:postgres@localhost:5432/nestboard
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# CORS:
# ====
# Comma-separated list of allowed browser origins. Native mobile apps do not
# send an Origin header, so they are unaffected by this.
CORS_ORIGINS=http://localhost:5173

# Rate limiting:
# =============
# Requests allowed per IP per 15 minutes.
RATE_LIMIT=100

# Google Sign-In:
# ==============
# Comma-separated OAuth client IDs from Google Cloud Console. Use the *web*
# client ID; mobile apps pass it as their webClientId. Add the Android and iOS
# client IDs here too if their tokens are minted against them.
# POST /api/auth/google returns 503 until this is set.
GOOGLE_CLIENT_IDS=

# File uploads:
# ============
# UPLOAD_PROVIDER is "local" or "r2".
# "local" writes to UPLOAD_LOCAL_DIR and serves the files from /uploads.
# Note that hosts like Render have an ephemeral disk, so locally stored files
# disappear on every deploy and restart.
UPLOAD_PROVIDER=local
UPLOAD_LOCAL_DIR=./uploads

# Cloudflare R2, only needed when UPLOAD_PROVIDER=r2. Keep these commented out
# while using the local provider: R2_PUBLIC_BASE_URL must be a valid URL, so an
# empty value fails validation and the server will not start.
# R2_PUBLIC_BASE_URL is the bucket's public r2.dev subdomain or custom domain.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
